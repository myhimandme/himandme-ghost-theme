{{!< default}}
{{!-- STAGE 1 VERIFICATION SCAFFOLD — replaced by the approved author page design in Stage 5. --}}
<main data-template="author">
    {{#author}}<h1>{{name}}</h1>{{/author}}
    <ul data-test="post-list">
        {{#foreach posts}}<li data-slug="{{slug}}"><a href="{{url}}">{{title}}</a></li>{{/foreach}}
    </ul>
    {{pagination}}
</main>
