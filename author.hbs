{{!< default}}
{{#contentFor "mode"}}blog{{/contentFor}}
{{#contentFor "preload"}}<link rel="preload" href="{{asset "fonts/newsreader-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>{{/contentFor}}
{{!-- Author page (/blog/penulis/{slug}/): the doctor's staff profile (name, photo, bio — Ghost Admin → Staff),
      the verified credentials (theme setting), then every article, paginated. --}}
{{> "site/blog-topbar"}}
{{> "site/header-blog"}}
<main id="main" class="hm-blog hm-author" data-template="author">
    {{#author}}
    <header class="hm-archive-head hm-archive-head--author hm-container-blog">
        {{#if profile_image}}<img class="hm-archive-head__photo" src="{{img_url profile_image size="s"}}" alt="{{name}}" width="112" height="112">{{else}}<div class="hm-archive-head__photo hm-ph" role="presentation"></div>{{/if}}
        <div class="hm-archive-head__text">
            <nav class="hm-archive-head__crumbs" aria-label="{{t "Laluan"}}"><a href="{{@site.url}}/blog/">{{t "Blog"}}</a> <span class="hm-archive-head__slash" aria-hidden="true">/</span> <span aria-current="page">{{name}}</span></nav>
            <span class="hm-kicker">{{t "DITULIS DAN DISEMAK OLEH"}}</span>
            <h1 class="hm-archive-head__title hm-serif">{{name}}</h1>
            {{#if @custom.doctor_credentials}}<span class="hm-archive-head__cred">{{> "icons/shield-check"}}{{@custom.doctor_credentials}}</span>{{/if}}
            {{#if bio}}<p class="hm-archive-head__desc">{{bio}}</p>{{/if}}
        </div>
    </header>
    {{/author}}
    {{> "blog/feed" heading=(t "Artikel")}}
    {{> "blog/cta"}}
</main>
{{> "site/footer-blog" links=true}}
