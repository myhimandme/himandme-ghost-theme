{{!< default}}
{{#contentFor "mode"}}blog{{/contentFor}}
{{#contentFor "preload"}}<link rel="preload" href="{{asset "fonts/newsreader-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>{{/contentFor}}
{{> "site/blog-topbar"}}
{{> "site/header-article"}}
{{!-- STAGE 1 VERIFICATION SCAFFOLD — replaced by the approved article design in Stage 6. --}}
<main id="main" data-template="post">
    {{#post}}
        <article data-slug="{{slug}}">
            <h1>{{title}}</h1>
            {{#primary_author}}<p data-test="attribution">Ditulis dan disemak oleh {{name}}</p>{{/primary_author}}
            {{content}}
        </article>
    {{/post}}
</main>
{{> "site/footer-blog"}}
{{> "site/mobile-bar" variant="article"}}
