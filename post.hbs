{{!< default}}
{{#contentFor "mode"}}blog{{/contentFor}}
{{#contentFor "preload"}}<link rel="preload" href="{{asset "fonts/newsreader-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>{{/contentFor}}
{{!-- Article (/blog/{slug}/) — the approved Artikel boards. Everything comes from the Ghost post: title, excerpt
      (standfirst), feature image + alt + caption, primary tag (category), tags, author (single attribution
      "Ditulis dan disemak oleh"), dates, reading time and the editor content. Internal tag #tanpa-cta hides the
      consultation card and the in-article band. Related lists are dynamic and never include #blok blocks. --}}
{{> "site/blog-topbar"}}
{{> "site/header-article"}}
<main id="main" class="hm-art" data-template="post">
    {{#post}}
    <article data-slug="{{slug}}">
        {{> "article/head"}}
        {{> "article/hero"}}
        <div class="hm-art__layout hm-container-blog">
            {{> "article/rail"}}
            <div class="hm-art__main">
                <div class="hm-art__content hm-doc__body hm-faq__list">
                    {{content}}
                </div>
                {{> "article/after"}}
            </div>
            {{> "article/aside"}}
        </div>
    </article>
    {{> "article/related"}}
    {{/post}}
</main>
{{> "site/footer-blog"}}
{{> "site/mobile-bar" variant="article"}}
