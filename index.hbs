{{!< default}}
{{#contentFor "mode"}}blog{{/contentFor}}
{{#contentFor "preload"}}<link rel="preload" href="{{asset "fonts/newsreader-latin-standard-normal.woff2"}}" as="font" type="font/woff2" crossorigin>{{/contentFor}}
{{!-- Blog home (/blog/, the collection; SEO from the page "jurnal"). Page 1: features + Paling dibaca, topic
      tiles, Terkini, Panduan band, consultation prompt. Page 2+: the article list only. --}}
{{> "site/blog-topbar"}}
{{> "site/header-blog"}}
<main id="main" class="hm-blog" data-template="index">
    {{#match pagination.page "<=" 1}}
        {{> "blog/features"}}
        {{> "blog/topics"}}
        <section class="hm-container-blog hm-show-mobile" aria-label="{{t "Paling dibaca"}}">{{> "blog/popular" class="hm-popular--mobile"}}</section>
    {{/match}}
    {{> "blog/feed"}}
    {{#match pagination.page "<=" 1}}
        {{> "blog/guides"}}
    {{/match}}
    {{> "blog/cta"}}
</main>
{{> "site/footer-blog" links=true}}
