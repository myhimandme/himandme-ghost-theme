{{!-- STAGE 1 VERIFICATION SCAFFOLD: renders every theme setting so the test suite can confirm
      Admin values reach the templates. Removed in Stage 2, when each setting is used in place. --}}
<dl data-test="settings-probe" hidden>
    <dt>whatsapp_number</dt><dd data-key="whatsapp_number">{{@custom.whatsapp_number}}</dd>
    <dt>whatsapp_default_message</dt><dd data-key="whatsapp_default_message">{{@custom.whatsapp_default_message}}</dd>
    <dt>phone_display</dt><dd data-key="phone_display">{{@custom.phone_display}}</dd>
    <dt>contact_email</dt><dd data-key="contact_email">{{@custom.contact_email}}</dd>
    <dt>address_short</dt><dd data-key="address_short">{{@custom.address_short}}</dd>
    <dt>google_maps_url</dt><dd data-key="google_maps_url">{{@custom.google_maps_url}}</dd>
    <dt>opening_hours_short</dt><dd data-key="opening_hours_short">{{@custom.opening_hours_short}}</dd>
    <dt>consultation_duration</dt><dd data-key="consultation_duration">{{@custom.consultation_duration}}</dd>
    <dt>consultation_fee</dt><dd data-key="consultation_fee">{{@custom.consultation_fee}}</dd>
    <dt>shockwave_session_duration</dt><dd data-key="shockwave_session_duration">{{@custom.shockwave_session_duration}}</dd>
    <dt>shockwave_session_count</dt><dd data-key="shockwave_session_count">{{@custom.shockwave_session_count}}</dd>
    <dt>shockwave_price</dt><dd data-key="shockwave_price">{{@custom.shockwave_price}}</dd>
    <dt>kegel_ems_session_duration</dt><dd data-key="kegel_ems_session_duration">{{@custom.kegel_ems_session_duration}}</dd>
    <dt>kegel_ems_session_count</dt><dd data-key="kegel_ems_session_count">{{@custom.kegel_ems_session_count}}</dd>
    <dt>kegel_ems_price</dt><dd data-key="kegel_ems_price">{{@custom.kegel_ems_price}}</dd>
    <dt>show_prices</dt><dd data-key="show_prices">{{#if @custom.show_prices}}true{{else}}false{{/if}}</dd>
    <dt>doctor_author_slug</dt><dd data-key="doctor_author_slug">{{@custom.doctor_author_slug}}</dd>
    <dt>doctor_credentials</dt><dd data-key="doctor_credentials">{{@custom.doctor_credentials}}</dd>
</dl>
