{{!-- Editorial blog masthead + category bar (blog home, topic and author pages).
      Categories: Settings → Site → Navigation → Secondary navigation. --}}
<header class="hm-bheader">
    <div class="hm-container-blog">
        <div class="hm-bheader__row">
            <button class="hm-icon-btn hm-bheader__menu" type="button" aria-controls="hm-menu" aria-expanded="false" data-hm-menu-open>
                {{> "icons/menu" short=true}}<span class="hm-visually-hidden">{{t "Buka menu"}}</span>
            </button>
            <a class="hm-bheader__logo" href="{{@site.url}}/">{{> "components/logo"}}</a>
            <a class="hm-bheader__title hm-serif" href="{{@site.url}}/blog/">{{t "Jurnal"}} <em>{{t "Kesihatan Lelaki"}}</em></a>
            <div class="hm-bheader__tools">
                {{!-- Theme search (Stage 5): searches published articles only. Ghost's native search is not used,
                      because its index also lists #blok content blocks; entries without a public URL are dropped. --}}
                <div class="hm-search" id="hm-search" data-hm-search data-key="{{content_api_key}}" data-api="{{@site.url}}">
                    <form class="hm-bsearch" role="search" action="{{@site.url}}/blog/">
                        <label class="hm-bsearch__field">
                            {{> "icons/search" size="18" stroke="1.8"}}
                            <span class="hm-visually-hidden">{{t "Cari artikel"}}</span>
                            <input class="hm-bsearch__input" type="search" name="q" placeholder="{{t "Cari artikel"}}" autocomplete="off" aria-controls="hm-search-results" data-hm-search-input>
                        </label>
                        <button class="hm-icon-btn hm-search__close" type="button" data-hm-search-close>{{> "icons/close"}}<span class="hm-visually-hidden">{{t "Tutup carian"}}</span></button>
                    </form>
                    {{!-- Without JavaScript the field is hidden and this note takes its place (no silent, dead search box). --}}
                    <p class="hm-search__nojs">{{t "Carian memerlukan JavaScript."}} <a href="{{@site.url}}/blog/#hm-topics-title">{{t "Lihat topik"}}</a></p>
                    <div class="hm-search__results" id="hm-search-results" hidden>
                        <p class="hm-search__status" role="status" aria-live="polite" data-hm-search-status></p>
                        <ol class="hm-search__list" data-hm-search-list></ol>
                    </div>
                </div>
                <button class="hm-icon-btn hm-bheader__search-btn" type="button" aria-controls="hm-search" aria-expanded="false" data-hm-search-open>
                    {{> "icons/search"}}<span class="hm-visually-hidden">{{t "Cari"}}</span>
                </button>
            </div>
        </div>
        <a class="hm-bheader__title-sm hm-serif" href="{{@site.url}}/blog/">{{t "Jurnal"}} <em>{{t "Kesihatan Lelaki"}}</em></a>
        <nav class="hm-cats" aria-label="{{t "Kategori"}}">
            <a class="{{link_class for="/blog/" class="hm-cats__link"}}" href="{{@site.url}}/blog/">{{t "Semua"}}</a>
            {{#foreach @site.secondary_navigation}}
                <a class="{{link_class for=url class="hm-cats__link"}}" href="{{url absolute="true"}}">{{> "site/cat-label"}}</a>
            {{/foreach}}
        </nav>
    </div>
</header>
{{> "site/menu" categories=true}}
