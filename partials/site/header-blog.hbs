{{!-- Editorial blog masthead + category bar (blog home, topic and author pages).
      Categories: Settings → Site → Navigation → Secondary navigation. Search behaviour: Stage 5. --}}
<header class="hm-bheader">
    <div class="hm-container-blog">
        <div class="hm-bheader__row">
            <button class="hm-icon-btn hm-bheader__menu" type="button" aria-controls="hm-menu" aria-expanded="false" data-hm-menu-open>
                {{> "icons/menu" short=true}}<span class="hm-visually-hidden">{{t "Buka menu"}}</span>
            </button>
            <a class="hm-bheader__logo" href="{{@site.url}}/">{{> "components/logo"}}</a>
            <a class="hm-bheader__title hm-serif" href="{{@site.url}}/blog/">{{t "Jurnal"}} <em>{{t "Kesihatan Lelaki"}}</em></a>
            <div class="hm-bheader__tools">
                <form class="hm-bsearch" role="search" action="{{@site.url}}/blog/" data-hm-search>
                    <label class="hm-bsearch__field">
                        {{> "icons/search" size="18" stroke="1.8"}}
                        <span class="hm-visually-hidden">{{t "Cari artikel"}}</span>
                        <input class="hm-bsearch__input" type="search" name="q" placeholder="{{t "Cari artikel"}}" autocomplete="off">
                    </label>
                </form>
                <button class="hm-icon-btn hm-bheader__search-btn" type="button" data-hm-search-open>
                    {{> "icons/search"}}<span class="hm-visually-hidden">{{t "Cari"}}</span>
                </button>
            </div>
        </div>
        <a class="hm-bheader__title-sm hm-serif" href="{{@site.url}}/blog/">{{t "Jurnal"}} <em>{{t "Kesihatan Lelaki"}}</em></a>
        <nav class="hm-cats" aria-label="{{t "Kategori"}}">
            <a class="{{link_class for="/blog/" class="hm-cats__link"}}" href="{{@site.url}}/blog/">{{t "Semua"}}</a>
            {{#foreach @site.secondary_navigation}}
                <a class="{{link_class for=url class="hm-cats__link"}}" href="{{url absolute="true"}}">{{label}}</a>
            {{/foreach}}
        </nav>
    </div>
</header>
{{> "site/menu" categories=true}}
