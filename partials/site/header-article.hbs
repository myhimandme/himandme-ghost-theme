{{!-- Article header: desktop = logo · blog title · search; mobile = back · logo · share.
      Reading-progress bar is filled by JS from Stage 6. --}}
<header class="hm-aheader">
    <div class="hm-container-blog hm-aheader__wrap">
        <div class="hm-aheader__row">
            <a class="hm-icon-btn hm-aheader__back" href="{{@site.url}}/blog/">{{> "icons/chevron-left"}}<span class="hm-visually-hidden">{{t "Kembali ke blog"}}</span></a>
            <a class="hm-aheader__logo" href="{{@site.url}}/blog/">{{> "components/logo"}}</a>
            <a class="hm-aheader__title hm-serif" href="{{@site.url}}/blog/">{{t "Jurnal"}} <em>{{t "Kesihatan Lelaki"}}</em></a>
            <button class="hm-icon-btn hm-aheader__search" type="button" data-hm-search-open>{{> "icons/search" size="20" stroke="1.8"}}<span class="hm-visually-hidden">{{t "Cari"}}</span></button>
            <button class="hm-icon-btn hm-aheader__share" type="button" data-hm-share>{{> "icons/share"}}<span class="hm-visually-hidden">{{t "Kongsi"}}</span></button>
        </div>
        <div class="hm-progress" aria-hidden="true"><div class="hm-progress__bar" data-hm-progress></div></div>
    </div>
</header>
