{{else match url "~" "/topik/kesihatan-pelvis/"}}{{> "site/cat-label-pair" full=label short=(t "PELVIS")}}
{{else match url "~" "/topik/seks-hubungan/"}}{{> "site/cat-label-pair" full=label short=(t "SEKS")}}
{{else match url "~" "/topik/gaya-hidup/"}}{{> "site/cat-label-pair" full=label short=(t "GAYA HIDUP")}}
{{else match url "~" "/topik/kesihatan-mental/"}}{{> "site/cat-label-pair" full=label short=(t "MINDA")}}
{{else}}{{label}}{{/match}}
