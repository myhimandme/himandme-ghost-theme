{{!-- Right rail (desktop only): consultation card (hidden by #tanpa-cta) and up to 2 related guides ("panduan"). --}}
<aside class="hm-art__aside" aria-label="{{t "Berkaitan"}}">
    {{#has tag="#tanpa-cta"}}{{else}}
    <div class="hm-art__card">
        <img src="{{asset "images/logo-mark.png"}}" alt="" width="40" height="40" loading="lazy">
        <p class="hm-art__card-title hm-serif">{{t "Ada soalan tentang artikel ini?"}}</p>
        <p class="hm-art__card-sub">{{t "Bincang secara sulit dengan doktor kami."}}</p>
        <a class="hm-btn hm-btn--primary hm-btn--block hm-art__card-btn" href="{{> "components/booking-href"}}">{{t "Buat Temu Janji"}}</a>
        <a class="hm-btn hm-btn--whatsapp hm-btn--block hm-art__card-btn" href="{{> "components/wa-href"}}" target="_blank" rel="noopener">{{> "icons/whatsapp" size="18"}}{{t "WhatsApp Kami"}}</a>
    </div>
    {{/has}}
    {{!-- Panduan berkaitan (approved Stage 6 refinement): "panduan" articles from the same topic first (newest
          first), then the newest from other topics; at most 2 shown; never this article, never a #blok block.
          Two separate queries (Ghost cannot nest them with the article's context); CSS shows the first 2 links
          and hides the whole box when there are none. --}}
    <nav class="hm-art__guides" aria-label="{{t "Panduan berkaitan"}}">
        <strong class="hm-art__guides-head">{{t "PANDUAN BERKAITAN"}}</strong>
        {{#if primary_tag}}
            {{#get "posts" filter="tag:panduan+tag:{{primary_tag.slug}}+id:-{{id}}+tag:-hash-blok" limit="2" as |same|}}{{#foreach same}}<a class="hm-serif" href="{{url}}" data-hm-guide="topic">{{title}}</a>{{/foreach}}{{/get}}
            {{#get "posts" filter="tag:panduan+tag:-{{primary_tag.slug}}+id:-{{id}}+tag:-hash-blok" limit="2" as |other|}}{{#foreach other}}<a class="hm-serif" href="{{url}}" data-hm-guide="other">{{title}}</a>{{/foreach}}{{/get}}
        {{else}}
            {{#get "posts" filter="tag:panduan+id:-{{id}}+tag:-hash-blok" limit="2" as |other|}}{{#foreach other}}<a class="hm-serif" href="{{url}}" data-hm-guide="other">{{title}}</a>{{/foreach}}{{/get}}
        {{/if}}
    </nav>
</aside>
