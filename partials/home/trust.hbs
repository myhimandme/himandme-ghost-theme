{{!-- Trust strip (fixed microcopy; shorter labels on phones, as on the mobile board). --}}
<section class="hm-trust" aria-label="{{t "Kenapa Him & Me"}}">
    <div class="hm-container hm-trust__grid">
        <div class="hm-trust__item">{{> "icons/lock"}}<span>{{t "Konsultasi sulit"}}</span></div>
        <div class="hm-trust__item hm-trust__item--2"><span class="hm-hide-mobile">{{> "icons/shield-check"}}</span><span class="hm-show-mobile">{{> "icons/shield"}}</span><span>{{t "Penilaian individu"}}</span></div>
        <div class="hm-trust__item hm-trust__item--3">{{> "icons/pulse"}}<span class="hm-hide-mobile">{{t "Pilihan rawatan bukan invasif"}}</span><span class="hm-show-mobile">{{t "Bukan invasif"}}</span></div>
        <div class="hm-trust__item">{{> "icons/whatsapp" size="26"}}<span class="hm-hide-mobile">{{t "Pertanyaan melalui WhatsApp"}}</span><span class="hm-show-mobile">WhatsApp</span></div>
    </div>
</section>
