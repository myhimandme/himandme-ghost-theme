<section class="hm-container hm-statement">
    <div class="hm-statement__text">
        <h2 class="hm-statement__title">{{title}}{{#if accent}} <span class="hm-statement__accent">{{accent}}</span>{{/if}}</h2>
        <div class="hm-statement__more">{{#if html}}{{{html}}}{{else}}<p>{{text}}</p>{{/if}}</div>
    </div>
    <a class="hm-link-arrow hm-statement__link" href="{{@site.url}}/disfungsi-ereksi/">{{t "Fahami disfungsi ereksi"}}{{> "icons/arrow-right"}}</a>
</section>
